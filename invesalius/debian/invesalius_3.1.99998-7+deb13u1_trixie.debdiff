diff -Nru invesalius-3.1.99998/debian/changelog invesalius-3.1.99998/debian/changelog
--- invesalius-3.1.99998/debian/changelog	2025-02-16 13:50:44.000000000 +0000
+++ invesalius-3.1.99998/debian/changelog	2026-11-10 14:30:10.000000000 +0000
@@ -1,3 +1,15 @@
+invesalius (3.1.99998-7+deb13u1) trixie; urgency=medium
+
+  * Team upload.
+  * fix-cve-2024-42845.patch: from 3.1.99998-8. Remove eval() from the DICOM
+    reader: a crafted DICOM file could run arbitrary code (CVE-2024-42845,
+    Closes: #1082875).
+  * CVE-2024-44825.patch: extract .inv3 project files with the "data" filter
+    of tarfile, so that a crafted project cannot write outside of its
+    temporary directory (CVE-2024-44825, Closes: #1136204).
+
+ -- Valentín Torassa <valentintorassacolombero@gmail.com>  Tue, 10 Nov 2026 11:40:00 -0300
+
 invesalius (3.1.99998-7) unstable; urgency=medium
 
   * Team upload.
diff -Nru invesalius-3.1.99998/debian/patches/CVE-2024-44825.patch invesalius-3.1.99998/debian/patches/CVE-2024-44825.patch
--- invesalius-3.1.99998/debian/patches/CVE-2024-44825.patch	1970-01-01 00:00:00.000000000 +0000
+++ invesalius-3.1.99998/debian/patches/CVE-2024-44825.patch	2026-11-10 14:40:00.000000000 +0000
@@ -0,0 +1,60 @@
+Description: Do not write outside of the project directory when opening .inv3 files
+ Extract() wrote every member of an .inv3 archive to
+ os.path.join(folder, member name) without checking the name, so a crafted
+ project file could create or overwrite any file the user can write
+ (CVE-2024-44825).
+ .
+ Extract the members with tarfile's "data" filter instead. Upstream does the
+ same since e4dda58, with tar_filter. The file list returned to the caller
+ is built from the filtered members, so it only has paths inside of the
+ destination directory. The mkdir of the first member's directory is
+ dropped: its name came from the archive as well, and tar.extract() creates
+ the directory itself.
+Author: Valentín Torassa <valentintorassacolombero@gmail.com>
+Origin: backport, https://github.com/invesalius/invesalius3/commit/e4dda58f5c9937af0c34d483ffc267168e47cf58
+Bug: https://github.com/invesalius/invesalius3/issues/1404
+Bug-Debian: https://bugs.debian.org/1136204
+Last-Update: 2026-11-10
+---
+This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
+--- a/invesalius/project.py
++++ b/invesalius/project.py
+@@ -493,19 +493,16 @@
+     folder = decode(folder, const.FS_ENCODE)
+ 
+     tar = tarfile.open(filename, "r")
+-    idir = decode(os.path.split(tar.getnames()[0])[0], 'utf8')
+-    os.mkdir(os.path.join(folder, idir))
+     filelist = []
+     for t in tar.getmembers():
+-        fsrc = tar.extractfile(t)
++        # The "data" filter keeps every member inside of folder: it strips
++        # leading slashes and refuses "..", links that point outside and
++        # special files. It returns the member under the name it is
++        # extracted as, which is the one to report to the caller.
++        t = tarfile.data_filter(t, folder)
++        tar.extract(t, path=folder, filter="data")
+         fname = os.path.join(folder, decode(t.name, 'utf-8'))
+-        fdst = open(fname, 'wb')
+-        shutil.copyfileobj(fsrc, fdst)
+         filelist.append(fname)
+-        fsrc.close()
+-        fdst.close()
+-        del fsrc
+-        del fdst
+     tar.close()
+     return filelist
+ 
+@@ -513,7 +510,10 @@
+ def Extract_(filename, folder):
+     tar = tarfile.open(filename, "r:gz")
+     #tar.list(verbose=True)
+-    tar.extractall(folder)
+-    filelist = [os.path.join(folder, i) for i in tar.getnames()]
++    filelist = []
++    for t in tar.getmembers():
++        t = tarfile.data_filter(t, folder)
++        tar.extract(t, path=folder, filter="data")
++        filelist.append(os.path.join(folder, t.name))
+     tar.close()
+     return filelist
diff -Nru invesalius-3.1.99998/debian/patches/fix-cve-2024-42845.patch invesalius-3.1.99998/debian/patches/fix-cve-2024-42845.patch
--- invesalius-3.1.99998/debian/patches/fix-cve-2024-42845.patch	1970-01-01 00:00:00.000000000 +0000
+++ invesalius-3.1.99998/debian/patches/fix-cve-2024-42845.patch	2026-11-10 14:27:51.000000000 +0000
@@ -0,0 +1,24 @@
+From: Thiago Franco de Moraes <totonixsame@gmail.com>
+Subject: Removed eval from dicom.py (#820)
+Origin: upstream, https://github.com/invesalius/invesalius3/commit/020cd6056c30105a870cfea99939282b6ec5640b
+
+--- a/invesalius/reader/dicom.py
++++ b/invesalius/reader/dicom.py
+@@ -443,7 +443,7 @@
+         except (KeyError):
+             return ""
+         if data:
+-            return [eval(value) for value in data.split("\\")]
++            return [float(value) for value in data.split("\\")]
+         return ""
+ 
+     def GetImageLocation(self):
+@@ -456,7 +456,7 @@
+         """
+         data = self.data_image[str(0x020)][str(0x1041)]
+         if data:
+-            return eval(data)
++            return float(data)
+         return ""
+ 
+     def GetImageOffset(self):
diff -Nru invesalius-3.1.99998/debian/patches/series invesalius-3.1.99998/debian/patches/series
