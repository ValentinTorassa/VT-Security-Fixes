+diff --git a/pydicom/tests/test_fileset.py b/pydicom/tests/test_fileset.py
+index 40bd9d833c..8ded8862da 100644
+--- a/pydicom/tests/test_fileset.py
++++ b/pydicom/tests/test_fileset.py
